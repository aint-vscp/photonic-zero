# Normalise to LF in the repository so contributors on Windows, Linux and macOS
# all see the same bytes. Without this, a Windows checkout commits CRLF and every
# cross-platform diff becomes unreadable.
* text=auto eol=lf

# Scripts that only ever run on Windows need native line endings.
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Never touch these.
*.png   binary
*.ppm   binary
*.wasm  binary
*.jar   binary
*.a     binary
*.so    binary
*.dll   binary
*.dylib binary

# Keep generated lock files out of diffs and language statistics.
Cargo.lock      linguist-generated=true
package-lock.json linguist-generated=true

# The specification is prose, not code.
rfc/*.md linguist-documentation=true
